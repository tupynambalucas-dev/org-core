{
  "folders": [
    {
      "name": ".github",
      "path": ".github"
    },
    {
      "name": "platform",
      "path": "platform"
    },
    {
      "name": "docs",
      "path": "docs"
    },
    {
      "name": "agent-mesh",
      "path": "agent-mesh"
    }
  ],
  "settings": {
    "git.autoRepositoryDetection": true,
    "search.useIgnoreFiles": false,
    "search.exclude": {
      "**/node_modules": true,
      "**/.pnpm-store": true,
      "**/.git": true,
      "**/dist": true,
      "**/.docusaurus": true,
      "**/.turbo": true
    },
    "files.exclude": {
      "**/.git": false
    }
  },
  "extensions": {
    "recommendations": [
      "bradlc.vscode-tailwindcss",
      "d-koppenhagen.file-tree-to-text-generator",
      "dbaeumer.vscode-eslint",
      "emanuelebartolesi.taskdeck",
      "esbenp.prettier-vscode",
      "github.vscode-github-actions",
      "redhat.vscode-yaml",
      "shd101wyy.markdown-preview-enhanced",
      "unifiedjs.vscode-mdx"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Antigravity CLI (Meta-Repo Scope)",
        "type": "process",
        "command": "wt.exe",
        "windows": {
          "command": "wt.exe",
          "args": [
            "-d",
            "${workspaceFolder:.github}\\..",
            "powershell.exe",
            "-NoExit",
            "-Command",
            "agy"
          ]
        },
        "problemMatcher": []
      },
      {
        "label": "Mani: Sync Repositories",
        "type": "shell",
        "command": "mani sync",
        "problemMatcher": []
      },
      {
        "label": "Mani: Check Git Status",
        "type": "shell",
        "command": "mani run status",
        "problemMatcher": []
      },
      {
        "label": "Mani: Pull All Main",
        "type": "shell",
        "command": "mani run pull",
        "problemMatcher": []
      }
    ]
  }
}

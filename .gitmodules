[submodule ".github"]
	path = .github
	url = git@github.com:tupynambalucas-dev/.github.git
	branch = main
	update = merge
	fetchRecurseSubmodules = on-demand
[submodule "platform"]
	path = platform
	url = git@github.com:tupynambalucas-dev/platform.git
	branch = main
	update = merge
	fetchRecurseSubmodules = on-demand
[submodule "docs"]
	path = docs
	url = git@github.com:tupynambalucas-dev/docs.git
	branch = main
	update = merge
	fetchRecurseSubmodules = on-demand
[submodule "agent-mesh"]
	path = agent-mesh
	url = git@github.com:tupynambalucas-dev/agent-mesh.git
	branch = main
	update = merge
	fetchRecurseSubmodules = on-demand
